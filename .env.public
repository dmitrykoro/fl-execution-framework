# Shared, non-secret configuration. Secrets belong in .env.private, which overrides this file.
#
# EXPERIMENT_DB_MODE selects where experiment results are stored:
#   local  - a SQLite file on this machine (no credentials needed)
#   server - upload to the research group's experiment server over HTTP
#   direct - connect straight to a PostgreSQL database
#   neon   - connect to a Neon cloud database
#
# In 'server' mode, a run without a usable EXPERIMENT_SERVER_URL and
# EXPERIMENT_SERVER_TOKEN automatically falls back to 'local' instead of failing,
# so the framework works without access to the group's infrastructure.
EXPERIMENT_DB_MODE=server
EXPERIMENT_SERVER_URL=https://gcis-lrvcs-rl.gccis.rit.edu

# Where the local SQLite database lives (used by 'local' mode and by the fallback).
# EXPERIMENT_DB_LOCAL_PATH=out/experiments.db
