{
  "shared_settings": {
    "strict_mode": "true",
    "remove_clients": "true",
    "dataset_keyword": "femnist_niid",
    "use_llm": "false",
    "num_of_rounds": 20,
    "num_of_clients": 10,
    "show_plots": "false",
    "save_plots": "true",
    "save_csv": "true",
    "training_device": "cpu",
    "cpus_per_client": 1,
    "gpus_per_client": 0.0,
    "trust_threshold": 0.15,
    "reputation_threshold": 0.15,
    "beta_value": 0.75,
    "num_of_clusters": 1,
    "model_type": "cnn",
    "llm_model": "microsoft/BiomedNLP-BiomedBERT-base-uncased-abstract-fulltext",
    "llm_finetuning": "lora",
    "llm_task": "mlm",
    "llm_chunk_size": 256,
    "mlm_probability": 0.15,
    "lora_rank": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "lora_target_modules": ["query", "value"],
    "num_krum_selections": 3,
    "training_subset_fraction": 0.9,
    "min_fit_clients": 10,
    "min_evaluate_clients": 10,
    "min_available_clients": 10,
    "evaluate_metrics_aggregation_fn": "weighted_average",
    "num_of_client_epochs": 1,
    "batch_size": 20,
    "preserve_dataset": "false",
    "begin_removing_from_round": 2,
    "attack_schedule": [
      {
        "attack_type": "label_flipping",
        "flip_fraction": 1.0,
        "start_round": 5,
        "end_round": 15,
        "specific_malicious_clients": [0, 1]
      },
      {
        "attack_type": "gaussian_noise",
        "attack_ratio": 0.95,
        "target_noise_snr": 5,
        "start_round": 1,
        "end_round": 10,
        "specific_malicious_clients": [0, 1]
      }
    ]
  },
  "simulation_strategies": [
    {
      "aggregation_strategy_keyword": "pid_v5_stateless_mean_based",
      "Kp": 1,
      "Ki": 0.5,
      "Kd": 0.05,
      "num_std_dev": 2.33
    },
    {
      "aggregation_strategy_keyword": "lqr_fed",
      "lqr_q": 1.0,
      "lqr_r": 2.3,
      "normalize_distances": "true"
    }
  ]
}