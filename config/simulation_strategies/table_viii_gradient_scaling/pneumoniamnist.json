{
  "shared_settings": {
    "dataset_keyword": "pneumoniamnist",
    "use_llm": "false",
    "model_type": "cnn",
    "num_of_rounds": 40,
    "num_of_clients": 8,
    "num_of_malicious_clients": 2,
    "show_plots": "false",
    "save_plots": "true",
    "save_csv": "true",
    "training_device": "cpu",
    "cpus_per_client": 1,
    "gpus_per_client": 0.0,
    "trust_threshold": 0.15,
    "beta_value": 0.75,
    "num_of_clusters": 1,
    "Kp": 1,
    "Ki": 0.05,
    "Kd": 0.05,
    "num_std_dev": 2,
    "training_subset_fraction": 0.8,
    "min_fit_clients": 8,
    "min_evaluate_clients": 8,
    "min_available_clients": 8,
    "evaluate_metrics_aggregation_fn": "weighted_average",
    "num_of_client_epochs": 3,
    "batch_size": 10,
    "preserve_dataset": "false",
    "begin_removing_from_round": 5,
    "attack_schedule": [
      {
        "start_round": 1,
        "end_round": 40,
        "attack_type": "gradient_scaling",
        "selection_strategy": "specific",
        "malicious_client_ids": [0, 1],
        "scale_factor": 10.0
      }
    ]
  },
  "simulation_strategies": [
    {
      "aggregation_strategy_keyword": "pid_standardized_score_based",
      "remove_clients": "true"
    },
    {
      "aggregation_strategy_keyword": "multi-krum",
      "remove_clients": "true",
      "num_krum_selections": 4
    },
    {
      "aggregation_strategy_keyword": "rfa",
      "remove_clients": "true"
    },
    {
      "aggregation_strategy_keyword": "bulyan",
      "remove_clients": "true",
      "num_krum_selections": 4
    },
    {
      "aggregation_strategy_keyword": "pid_standardized_score_based",
      "remove_clients": "false"
    }
  ]
}
