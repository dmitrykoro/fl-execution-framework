{
  "shared_settings": {
    "dataset_keyword": "medquad",
    "use_llm": "true",
    "model_type": "transformer",
    "llm_model": "microsoft/BiomedNLP-BiomedBERT-base-uncased-abstract-fulltext",
    "llm_task": "mlm",
    "llm_finetuning": "lora",
    "llm_chunk_size": 256,
    "mlm_probability": 0.15,
    "lora_rank": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.1,
    "lora_target_modules": ["query", "value"],
    "num_of_rounds": 10,
    "num_of_clients": 8,
    "num_of_malicious_clients": 1,
    "show_plots": "false",
    "save_plots": "true",
    "save_csv": "true",
    "training_device": "gpu",
    "cpus_per_client": 1,
    "gpus_per_client": 1,
    "trust_threshold": 0.15,
    "beta_value": 0.75,
    "num_of_clusters": 1,
    "Kp": 1,
    "Ki": 0.5,
    "Kd": 0.05,
    "num_std_dev": 2.33,
    "training_subset_fraction": 0.9,
    "min_fit_clients": 8,
    "min_evaluate_clients": 8,
    "min_available_clients": 8,
    "evaluate_metrics_aggregation_fn": "weighted_average",
    "num_of_client_epochs": 1,
    "batch_size": 8,
    "preserve_dataset": "false",
    "begin_removing_from_round": 1,
    "attack_schedule": [
      {
        "start_round": 1,
        "end_round": 10,
        "attack_type": "gradient_scaling",
        "selection_strategy": "specific",
        "malicious_client_ids": [0],
        "scale_factor": 10.0
      }
    ]
  },
  "simulation_strategies": [
    {
      "aggregation_strategy_keyword": "pid_standardized_score_based",
      "remove_clients": "true"
    },
    {
      "aggregation_strategy_keyword": "multi-krum",
      "remove_clients": "true",
      "num_krum_selections": 7
    },
    {
      "aggregation_strategy_keyword": "rfa",
      "remove_clients": "true"
    },
    {
      "aggregation_strategy_keyword": "bulyan",
      "remove_clients": "true",
      "num_krum_selections": 6
    },
    {
      "aggregation_strategy_keyword": "pid_standardized_score_based",
      "remove_clients": "false"
    }
  ]
}
