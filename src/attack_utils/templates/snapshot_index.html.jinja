<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attack Snapshots - {{ run_id }}</title>
    <style>
        :root {
            color-scheme: light;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --bg: #f4f4f5;
            --panel: #ffffff;
            --panel-muted: #fafafa;
            --border: #e4e4e7;
            --border-soft: #f1f5f9;
            --text: #18181b;
            --text-muted: #71717a;
            --text-soft: #52525b;
            --accent: #18181b;
            --accent-hover: #27272a;
            --success-bg: #ecfdf5;
            --success-text: #047857;
            --warning-bg: #fffbeb;
            --warning-text: #a16207;
            --danger-bg: #fff1f2;
            --danger-text: #be123c;
            --info-bg: #eff6ff;
            --info-text: #1d4ed8;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            padding: 24px;
        }
        a {
            color: inherit;
        }
        .page {
            max-width: 1400px;
            margin: 0 auto;
        }
        .shell {
            border: 1px solid var(--border);
            border-radius: 24px;
            background: var(--panel);
            box-shadow: 0 1px 2px rgba(24, 24, 27, 0.06);
            overflow: hidden;
        }
        .header {
            padding: 32px;
            background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
            border-bottom: 1px solid var(--border);
        }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: var(--panel);
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .header h1 {
            margin-top: 14px;
            font-size: 32px;
            line-height: 1.1;
            letter-spacing: -0.03em;
        }
        .header .meta {
            margin-top: 10px;
            font-size: 14px;
            color: var(--text-muted);
        }
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            padding: 24px 32px;
            background: var(--panel-muted);
            border-bottom: 1px solid var(--border);
        }
        .stat {
            padding: 18px;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 20px;
        }
        .stat-value {
            font-size: 28px;
            font-weight: 600;
            letter-spacing: -0.03em;
        }
        .stat-label {
            margin-top: 6px;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        .controls {
            padding: 20px 32px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            border-bottom: 1px solid var(--border);
            background: var(--panel);
        }
        .search-box {
            flex: 1;
            min-width: 220px;
            padding: 11px 14px;
            border: 1px solid var(--border);
            border-radius: 14px;
            font-size: 14px;
            color: var(--text);
            background: var(--panel);
            outline: none;
        }
        .search-box:focus,
        .filter-group select:focus {
            border-color: #d4d4d8;
            box-shadow: 0 0 0 3px rgba(228, 228, 231, 0.9);
        }
        .filter-group {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: var(--panel-muted);
        }
        .filter-group label {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        .filter-group select {
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 14px;
            background: var(--panel);
            color: var(--text);
            outline: none;
        }
        .table-container {
            padding: 24px 32px 32px;
        }
        .table-shell {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 20px;
            background: var(--panel);
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        thead {
            background: var(--panel-muted);
            position: sticky;
            top: 0;
        }
        th {
            padding: 14px 16px;
            text-align: left;
            font-weight: 600;
            color: var(--text-soft);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
            user-select: none;
            border-bottom: 1px solid var(--border);
        }
        th:hover { background: #f4f4f5; }
        th::after { content: " ⇅"; opacity: 0.3; }
        td {
            padding: 16px;
            border-bottom: 1px solid var(--border-soft);
            font-size: 14px;
            vertical-align: top;
        }
        tbody tr:hover { background: #fafafa; }
        tbody tr:last-child td { border-bottom: none; }
        .table-number {
            font-weight: 600;
            color: var(--text);
        }
        .attack-list {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .attack-type {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border: 1px solid transparent;
        }
        .attack-type.label_flipping { background: var(--warning-bg); color: var(--warning-text); border-color: #fde68a; }
        .attack-type.gaussian_noise { background: var(--info-bg); color: var(--info-text); border-color: #bfdbfe; }
        .attack-type.token_replacement { background: var(--success-bg); color: var(--success-text); border-color: #a7f3d0; }
        .attack-type.unknown { background: #f4f4f5; color: #52525b; border-color: #e4e4e7; }
        .params {
            color: var(--text-muted);
            font-size: 13px;
            max-width: 420px;
        }
        .files { text-align: center; }
        .files a {
            text-decoration: none;
            font-size: 16px;
            margin: 0 4px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--panel);
            transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
        }
        .files a:hover {
            background: var(--panel-muted);
            border-color: #d4d4d8;
            transform: translateY(-1px);
        }
        .no-results {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
            font-size: 14px;
            border: 1px dashed var(--border);
            border-radius: 20px;
            background: var(--panel-muted);
            margin-top: 16px;
        }
        @media (max-width: 900px) {
            body {
                padding: 16px;
            }
            .header,
            .stats,
            .controls,
            .table-container {
                padding-left: 18px;
                padding-right: 18px;
            }
            .header h1 {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
    <div class="page">
    <div class="shell">
        <div class="header">
            <div class="eyebrow">Experiment Snapshot Browser</div>
            <h1>Attack Snapshots</h1>
            <div class="meta">
                <strong>Run ID:</strong> {{ run_id }} &nbsp;|&nbsp;
                <strong>Clients:</strong> {{ total_clients }} &nbsp;|&nbsp;
                <strong>Rounds:</strong> {{ total_rounds }} &nbsp;|&nbsp;
                <strong>Generated:</strong> {{ timestamp }}
            </div>
        </div>

        <div class="stats">
            <div class="stat">
                <div class="stat-value">{{ snapshot_data|length }}</div>
                <div class="stat-label">Total Snapshots</div>
            </div>
            <div class="stat">
                <div class="stat-value">{{ unique_clients|length }}</div>
                <div class="stat-label">Clients Attacked</div>
            </div>
            <div class="stat">
                <div class="stat-value">{{ unique_rounds|length }}</div>
                <div class="stat-label">Rounds with Attacks</div>
            </div>
            <div class="stat">
                <div class="stat-value">{{ unique_attack_types|length }}</div>
                <div class="stat-label">Attack Types</div>
            </div>
        </div>

        <div class="controls">
            <input type="text" id="searchBox" class="search-box" placeholder="🔍 Search by client, round, or attack type...">
            <div class="filter-group">
                <label for="clientFilter">Client:</label>
                <select id="clientFilter">
                    <option value="">All</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="attackFilter">Attack:</label>
                <select id="attackFilter">
                    <option value="">All</option>
                </select>
            </div>
        </div>

        <div class="table-container">
            <div class="table-shell">
            <table id="snapshotTable">
                <thead>
                    <tr>
                        <th onclick="sortTable(0)">Client</th>
                        <th onclick="sortTable(1)">Round</th>
                        <th onclick="sortTable(2)">Attack Type</th>
                        <th onclick="sortTable(3)">Samples</th>
                        <th>Parameters</th>
                        <th>Files</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    {% for item in snapshot_data %}
                    <tr>
                        <td class="table-number">{{ item.client }}</td>
                        <td class="table-number">{{ item.round }}</td>
                        <td>
                            <div class="attack-list">
                            {% for attack_type in item.attack_types %}
                            <span class="attack-type {{ attack_type }}">{{ attack_type }}</span>
                            {% endfor %}
                            </div>
                        </td>
                        <td class="table-number">{{ item.samples }}</td>
                        <td class="params">{{ item.parameters }}</td>
                        <td class="files">
                            <a href="{{ item.pickle_path }}" title="Download pickle file">📦</a>
                            {% if item.visual_type == "text" %}
                            <a href="{{ item.visual_path }}" target="_blank" title="View text samples">📝</a>
                            {% else %}
                            <a href="{{ item.visual_path }}" target="_blank" title="View visual">🖼️</a>
                            {% endif %}
                            <a href="{{ item.metadata_path }}" target="_blank" title="View metadata">📄</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
            <div id="noResults" class="no-results" style="display: none;">
                No snapshots match your filters.
            </div>
        </div>
    </div>
    </div>

    <script>
        // Convert snake_case to Title Case
        function toTitleCase(snakeStr) {
            return snakeStr
                .split('_')
                .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                .join(' ');
        }

        // Populate filter dropdowns
        const clients = new Set();
        const attacks = new Set();
        document.querySelectorAll('#tableBody tr').forEach(row => {
            clients.add(row.cells[0].textContent);
            attacks.add(row.cells[2].textContent.trim());
        });

        const clientFilter = document.getElementById('clientFilter');
        const attackFilter = document.getElementById('attackFilter');

        [...clients].sort((a, b) => Number(a) - Number(b)).forEach(client => {
            const option = document.createElement('option');
            option.value = client;
            option.textContent = `Client ${client}`;
            clientFilter.appendChild(option);
        });

        [...attacks].sort().forEach(attack => {
            const option = document.createElement('option');
            option.value = attack;
            option.textContent = toTitleCase(attack);
            attackFilter.appendChild(option);
        });

        // Filter functionality
        function applyFilters() {
            const searchTerm = document.getElementById('searchBox').value.toLowerCase();
            const clientValue = document.getElementById('clientFilter').value;
            const attackValue = document.getElementById('attackFilter').value;

            const rows = document.querySelectorAll('#tableBody tr');
            let visibleCount = 0;

            rows.forEach(row => {
                const client = row.cells[0].textContent;
                const round = row.cells[1].textContent;
                const attack = row.cells[2].textContent.trim();

                const matchesSearch = !searchTerm ||
                    client.includes(searchTerm) ||
                    round.includes(searchTerm) ||
                    attack.toLowerCase().includes(searchTerm);

                const matchesClient = !clientValue || client === clientValue;
                const matchesAttack = !attackValue || attack === attackValue;

                const visible = matchesSearch && matchesClient && matchesAttack;
                row.style.display = visible ? '' : 'none';
                if (visible) visibleCount++;
            });

            document.getElementById('noResults').style.display = visibleCount === 0 ? 'block' : 'none';
        }

        document.getElementById('searchBox').addEventListener('input', applyFilters);
        document.getElementById('clientFilter').addEventListener('change', applyFilters);
        document.getElementById('attackFilter').addEventListener('change', applyFilters);

        // Table sorting
        let sortDirection = 1;
        let lastSortColumn = -1;

        function sortTable(columnIndex) {
            const table = document.getElementById('snapshotTable');
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'));

            // Toggle direction if same column
            if (columnIndex === lastSortColumn) {
                sortDirection *= -1;
            } else {
                sortDirection = 1;
                lastSortColumn = columnIndex;
            }

            rows.sort((a, b) => {
                let aVal = a.cells[columnIndex].textContent.trim();
                let bVal = b.cells[columnIndex].textContent.trim();

                // Numeric sorting for client/round/samples
                if (columnIndex === 0 || columnIndex === 1 || columnIndex === 3) {
                    aVal = Number(aVal);
                    bVal = Number(bVal);
                }

                if (aVal < bVal) return -1 * sortDirection;
                if (aVal > bVal) return 1 * sortDirection;
                return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
        }
    </script>
</body>
</html>
